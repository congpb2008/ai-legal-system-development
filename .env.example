# --- Core ---
APP_NAME=Banking Legal Assistant
ENVIRONMENT=development
DEBUG=true

# SQLite for local dev. For production use PostgreSQL, e.g.
# DATABASE_URL=postgresql+psycopg://legal:legal@postgres:5432/legal
DATABASE_URL=sqlite:///data/legal.db
DATA_DIR=data
SECRET_KEY=change-me-in-production
SESSION_COOKIE=legal_session
SESSION_TTL_SECONDS=43200

# --- Bootstrap admin ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123

# --- Uploads ---
MAX_UPLOAD_MB=200

# --- LLM (OpenAI-compatible) ---
# Leave LLM_BASE_URL empty to use the built-in extractive fallback.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=300

# --- Embeddings ---
# hash = local deterministic embeddings (default), openai = OpenAI-compatible endpoint
EMBEDDING_PROVIDER=hash
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=384

# --- OCR ---
# auto tries PaddleOCR, then Tesseract. Use none to skip OCR for text-layer PDFs.
# The Docker image includes Tesseract + Vietnamese language data.
# For PaddleOCR locally: uv sync --extra ocr
OCR_PROVIDER=auto
OCR_LANG=vi
OCR_DPI=220
OCR_MIN_TEXT_CHARS=40

# --- Worker ---
RUN_WORKER_INPROCESS=true
WORKER_POLL_SECONDS=1.0

# --- CORS ---
CORS_ORIGINS=http://localhost:5173,http://localhost:8000,http://127.0.0.1:5173
